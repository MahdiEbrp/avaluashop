{
   "name": "avaluashop",
   "version": "1.0.0",
   "private": true,
   "description": "Avaluashop — Iranian storefront and admin panel in one Next.js application",
   "author": {
      "name": "AvaluaShop",
      "url": "https://avaluashop.com"
   },
   "license": "MIT",
   "engines": {
      "node": ">=20"
   },
   "scripts": {
      "dev": "next dev -p 3000 -H 0.0.0.0",
      "build": "next build",
      "start": "next start",
      "lint": "eslint . --max-warnings 0",
      "typecheck": "tsc --noEmit",
      "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\"",
      "postinstall": "prisma generate",
      "prepare": "husky install",
      "db:up": "bash scripts/dev-db.sh up",
      "db:down": "bash scripts/dev-db.sh stop",
      "db:status": "bash scripts/dev-db.sh status",
      "db:generate": "prisma generate",
      "db:format": "prisma format",
      "db:reset": "prisma db push --force-reset",
      "db:push": "prisma db push",
      "db:seed": "prisma db seed",
      "db:studio": "prisma studio",
      "update": "npx npm-check-updates -u",
      "test": "npm run test:e2e && npm run test:stress",
      "test:e2e": "node tests/e2e.mjs",
      "test:stress": "node tests/stress.mjs"
   },
   "dependencies": {
      "@hookform/resolvers": "^7.0.6",
      "@persepolis/mail": "^1.1.0",
      "@persepolis/regex": "^0.0.3",
      "@persepolis/rng": "^0.0.1",
      "@persepolis/slugify": "^0.0.1",
      "@persepolis/sms": "^0.0.1",
      "@persepolis/ui": "^0.1.9",
      "@prisma/adapter-pg": "^7.10.1",
      "@prisma/client": "^7.10.1",
      "@radix-ui/react-accordion": "^1.3.1",
      "@radix-ui/react-alert-dialog": "^1.1.9",
      "@radix-ui/react-avatar": "^1.3.1",
      "@radix-ui/react-checkbox": "^1.4.1",
      "@radix-ui/react-dialog": "^1.3.1",
      "@radix-ui/react-dropdown-menu": "^2.2.1",
      "@radix-ui/react-icons": "^1.3.2",
      "@radix-ui/react-label": "^2.1.17",
      "@radix-ui/react-navigation-menu": "^1.4.1",
      "@radix-ui/react-popover": "^1.3.1",
      "@radix-ui/react-scroll-area": "^1.4.0",
      "@radix-ui/react-select": "^2.4.1",
      "@radix-ui/react-separator": "^1.2.0",
      "@radix-ui/react-slot": "^1.5.0",
      "@radix-ui/react-switch": "^1.4.1",
      "@radix-ui/react-tabs": "^1.2.1",
      "@radix-ui/react-toast": "^1.3.1",
      "@radix-ui/react-toggle": "^1.2.1",
      "@react-email/components": "^1.0.12",
      "@react-email/render": "^2.3.1",
      "@tanstack/react-table": "^9.3.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "^1.1.1",
      "date-fns": "^4.4.0",
      "embla-carousel-autoplay": "^8.6.0",
      "embla-carousel-react": "^8.6.0",
      "jose": "^6.2.17",
      "lucide-react": "^1.73.0",
      "next": "16.4.6",
      "next-cloudinary": "^7.1.0",
      "next-mdx-remote": "^6.0.0",
      "next-themes": "^0.4.6",
      "nodemailer": "^10.5.0",
      "pg": "^8.16.3",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-hook-form": "^7.92.0",
      "react-hot-toast": "^2.6.1",
      "recharts": "^3.10.1",
      "swr": "^2.5.1",
      "zod": "^4.6.7",
      "zustand": "^5.1.0"
   },
   "devDependencies": {
      "@commitlint/cli": "^19.5.0",
      "@commitlint/config-conventional": "^19.5.0",
      "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
      "@shadcn/lint": "^0.2.5",
      "@tailwindcss/postcss": "^4.3.5",
      "@trivago/prettier-plugin-sort-imports": "^6.0.2",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@typescript-eslint/eslint-plugin": "^8.8.1",
      "@typescript-eslint/parser": "^8.8.1",
      "dotenv": "^18.0.10",
      "eslint": "^10.15.0",
      "eslint-config-next": "16.4.6",
      "eslint-plugin-import-x": "^4.18.1",
      "eslint-plugin-jsx-a11y": "^6.10.2",
      "eslint-plugin-no-secrets": "^2.3.3",
      "eslint-plugin-react": "^7.37.1",
      "eslint-plugin-security": "^4.2.1",
      "eslint-plugin-sonarjs": "^4.2.2",
      "eslint-plugin-unicorn": "^65.0.1",
      "husky": "^9.1.6",
      "lint-staged": "^15.2.10",
      "postcss": "^8.5.33",
      "prettier": "^3.10.1",
      "prettier-plugin-tailwindcss": "^0.8.1",
      "prisma": "^7.10.1",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.5",
      "tsx": "^4.23.15",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.72.2"
   }
}
