# Copy to .env and fill in. Required: DATABASE_URL, JWT_SECRET_KEY, OTP_PEPPER.

DATABASE_URL="postgresql://shop:shop@127.0.0.1:5432/avaluashop?schema=public"

NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Server-side encryption key for database-stored gateway credentials.
# Generate with: openssl rand -base64 32
# Required before saving or enabling gateway credentials in /admin/settings.
# Rotating it makes already-stored gateway credentials unreadable.
APP_SETTINGS_ENCRYPTION_KEY=""

# 32+ random characters. Signs the session cookie. Changing it signs everyone out.
JWT_SECRET_KEY=""

# 32+ random characters. Keys the HMAC of login codes. Required for OTP sign-in.
# Generate with: openssl rand -base64 32
OTP_PEPPER=""

# Shared rate limiter for OTP sends and checks. Without these, limits apply
# per serverless instance only (a warning is logged at startup).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bearer secret for /api/internal/* (Vercel Cron sends it automatically).
# 16+ characters. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Optional: image upload in the admin panel.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Optional: Google sign-in.
NEXT_PUBLIC_GOOGLE_OAUTH_ID=""
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URL=""
GOOGLE_OAUTH_SECRET=""

# Optional: Google Analytics tag.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Optional: Twitter (X) integration.
TWITTER_API_KEY=""

# Optional: OTP + invoice mail. Without it the OTP is logged to the server console.
MAIL_SMTP_SERVICE="Gmail"
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
